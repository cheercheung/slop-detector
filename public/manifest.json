{
  "manifest_version": 3,
  "name": "Slop Detector · X & LinkedIn",
  "version": "2.1.3",
  "description": "Filter low-quality AI content on X and LinkedIn. EvoLink Luna Decision, OpenRouter and Jev. English / 简体中文.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "optional_host_permissions": [
    "https://openrouter.ai/*",
    "https://api.typesafe.ai/*",
    "https://direct.evolink.ai/*",
    "https://api.gptzero.me/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Slop Detector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://openrouter.ai https://api.typesafe.ai https://direct.evolink.ai https://api.gptzero.me"
  }
}

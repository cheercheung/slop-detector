{
  "name": "slop-detector",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "node scripts/demo.mts",
    "build": "node scripts/build.mts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json && tsc -p proxy/tsconfig.json && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs && node tests/viewport.mjs && node tests/loading.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:package && npm run check:repo",
    "package": "npm run build && node scripts/package.mjs",
    "configure:proxy": "node scripts/configure-proxy.mjs",
    "proxy:login": "wrangler login",
    "proxy:dev": "wrangler dev --config proxy/wrangler.jsonc",
    "privacy:build": "node scripts/render-privacy.mts",
    "proxy:deploy": "npm run privacy:build && wrangler deploy --config proxy/wrangler.jsonc",
    "test:proxy": "node tests/proxy.mjs",
    "test:gptzero": "node tests/gptzero-browser.mjs",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:all": "npm run check && npm run test:proxy && npm run test:browser && npm run test:gptzero",
    "test:package": "node scripts/check-package.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "test:customization": "node tests/customization-browser.mjs"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.106",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261010.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "^0.1.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "miniflare": "5.20261006.1-alpha",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "description": "Bilingual Chrome extension for filtering low-quality AI content on X and LinkedIn. EvoLink Luna Decision, OpenRouter and Jev.",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cheercheung/slop-detector.git"
  },
  "homepage": "https://github.com/cheercheung/slop-detector#readme",
  "bugs": {
    "url": "https://github.com/cheercheung/slop-detector/issues"
  }
}
